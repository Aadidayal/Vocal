# Server-side local configuration placeholders only.
# Replace these locally; never put real secrets in this tracked file.
MONGODB_URI=
PORT=
CORS_ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=replace-with-server-only-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
REMINDER_FROM_EMAIL=Reminders <reminders@example.com>
REMINDER_CRON_SECRET=replace-with-long-random-secret
